<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title><%= projectName %></title>

  <meta
    name="viewport"
    content="width=device-width,user-scalable=no,initial-scale=1,minimum-scale=1,maximum-scale=1,viewport-fit=cover"
  />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="format-detection" content="telephone=no" />

  <meta name="renderer" content="webkit" />
  <meta name="force-rendering" content="webkit" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
  <meta name="msapplication-tap-highlight" content="no" />

  <meta name="full-screen" content="yes" />
  <meta name="screen-orientation" content="landscape" />
  <meta name="x5-fullscreen" content="true" />
  <meta name="360-fullscreen" content="true" />
  <meta name="x5-page-mode" content="app" />

  <link rel="stylesheet" type="text/css" href="<%= cssUrl %>" />
</head>
<body>
  <div id="GameDiv" cc_exact_fit_screen="true">
    <div id="Cocos3dGameContainer">
      <canvas id="GameCanvas" oncontextmenu="event.preventDefault()" tabindex="99"></canvas>
    </div>
  </div>

  <div id="boot-splash" aria-hidden="true">
    <div class="splash-card">
      <div class="splash-title">TAKEOVER</div>
      <div class="splash-sub">LOADING BATTLEFIELDS...</div>
      <div class="splash-bar"><div class="splash-bar-fill"></div></div>
    </div>
  </div>

  <div id="rotate-overlay" role="dialog" aria-live="polite">
    <div class="rotate-card">
      <div class="rotate-icon" aria-hidden="true"></div>
      <div class="rotate-title">Please rotate your device to landscape</div>
      <div class="rotate-sub">请横屏游玩 · Takeover 需横向全屏体验</div>
    </div>
  </div>

  <script>
    window.addEventListener('contextmenu', function (e) {
      e.preventDefault();
    });
    setTimeout(function () {
      var el = document.getElementById('boot-splash');
      if (el) el.classList.add('hidden');
    }, 15000);
  </script>
  <%- include(cocosTemplate, {}) %>
</body>
</html>
